<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <RootNamespace>Stellar.EntityInspector</RootNamespace>
    <AssemblyName>Stellar.EntityInspector</AssemblyName>
    <Version>1.1.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Stellar.Abstractions" Version="1.9.0" />
    <PackageReference Include="Stellar.PluginContracts" Version="1.9.0" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="1.9.0" />
  </ItemGroup>
  <!-- Local overrides: deploy targets, game paths, local framework refs — all in Local.props (gitignored) -->
  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />
</Project>
