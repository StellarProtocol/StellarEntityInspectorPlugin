<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <RootNamespace>Stellar.EntityInspector</RootNamespace>
    <AssemblyName>Stellar.EntityInspector</AssemblyName>
    <Version>2.4.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- 2.31.0: house-style window (Stellar Design Language) — BubbleElement fills/outlines, ImageElement.Tint,
         theme status colours (Success / Caution / Danger), WindowSpec.Prebuild + ConditionalElement.Prebuild/KeepAlive
         (instant tab switches), EntityVitals.Shield (HP bar shield segment), SocialIdentity title + collect points,
         FashionEntry.DyeAreas (wardrobe dye slots), SocialSnapshot.Location/Party (Location + Party tabs). -->
    <PackageReference Include="Stellar.Abstractions"       Version="2.32.0" />
    <PackageReference Include="Stellar.PluginContracts"    Version="2.32.0" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="2.32.0" />
  </ItemGroup>
  <!-- Local overrides: deploy targets, game paths, local framework refs — all in Local.props (gitignored) -->
  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />
  <ItemGroup>
    <EmbeddedResource Include="Lang/en.json" LogicalName="Stellar.EntityInspector.Lang.en.json" />
    <EmbeddedResource Include="Lang/ja.json" LogicalName="Stellar.EntityInspector.Lang.ja.json" />
    <EmbeddedResource Include="Lang/th.json" LogicalName="Stellar.EntityInspector.Lang.th.json" />
    <EmbeddedResource Include="Lang/id.json" LogicalName="Stellar.EntityInspector.Lang.id.json" />
    <EmbeddedResource Include="Lang/fil.json" LogicalName="Stellar.EntityInspector.Lang.fil.json" />
    <EmbeddedResource Include="Lang/ko.json" LogicalName="Stellar.EntityInspector.Lang.ko.json" />
    <!-- Window glyphs (data tags radar/lock/card, hatched undyed swatch, popover ✕): white flat PNGs, one pre-drawn
         bitmap per on-screen size (tools/gen_icons.py → Icons/<name>-<px>.png), tinted with theme colours at draw time. -->
    <EmbeddedResource Include="Icons/*.png" LogicalName="Stellar.EntityInspector.Icons.%(Filename).png" />
  </ItemGroup>
</Project>
